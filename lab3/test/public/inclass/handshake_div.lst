# handshake_div listing
#-----------------------------------------------------------------------------
#
# Single DIV handshake reference (in-class waveform).
# code @ 0x200, data @ 0x800
#

  00000200: 00000093      li x1, 0
  00000204: 00000113      li x2, 0
  00000208: 00000193      li x3, 0
  0000020c: 00000213      li x4, 0
  00000210: 00000293      li x5, 0
  00000214: 00000313      li x6, 0
  00000218: 00000393      li x7, 0
  0000021c: 00000413      li x8, 0
  00000220: 00000493      li x9, 0
  00000224: 00000513      li x10, 0
  00000228: 00000593      li x11, 0
  0000022c: 00000613      li x12, 0
  00000230: 00000693      li x13, 0
  00000234: 00000713      li x14, 0
  00000238: 00000793      li x15, 0
  0000023c: 00000813      li x16, 0
  00000240: 00000893      li x17, 0
  00000244: 00000913      li x18, 0
  00000248: 00000993      li x19, 0
  0000024c: 00000a13      li x20, 0
  00000250: 00000a93      li x21, 0
  00000254: 00000b13      li x22, 0
  00000258: 00000b93      li x23, 0
  0000025c: 00000c13      li x24, 0
  00000260: 00000c93      li x25, 0
  00000264: 00000d13      li x26, 0
  00000268: 00000d93      li x27, 0
  0000026c: 00000e13      li x28, 0
  00000270: 00000e93      li x29, 0
  00000274: 00000f13      li x30, 0
  00000278: 00000f93      li x31, 0
  0000027c: 000012b7      lui x5, 0x1 # x5 = data block base
  00000280: 80028293      addi x5, x5, -2048
  00000284: 00200193      li x3, 2 # gp=2: hang before handshake completes
  00000288: 0002ae83      lw x29, 0(x5) # load ALUOP (DIV=1)
  0000028c: 0042af03      lw x30, 4(x5) # load OP1 (3.0)
  00000290: 00000013      nop
  00000294: 00000013      nop
  00000298: 0082af83      lw x31, 8(x5) # load OP2 (1.5)
  0000029c: 01b2a623      sw x27, 12(x5) # store result to memory
  000002a0: 00300193      li x3, 3 # check result
  000002a4: 00c2aa83      lw x21, 12(x5) # read back result
  000002a8: 40000b37      lui x22, 0x40000 # expected 2.0
  000002ac: 016a9e63      bne x21, x22, fail
pass:
  000002b0: 00100193      li x3, 1
  000002b4: 00000013      nop
  000002b8: 00000013      nop
  000002bc: 00000013      nop
  000002c0: 00000013      nop
  000002c4: 0180006f      j theend
fail:
  000002c8: 00000013      nop
  000002cc: 00000013      nop
  000002d0: 00000013      nop
  000002d4: 00000013      nop
  000002d8: 0040006f      j theend
theend:
  000002dc: 00000013      nop
  000002e0: 00000013      nop
  000002e4: 00000013      nop
  000002e8: 00000013      nop

# data
  00000800: 00000001  # ALUOP (DIV)
  00000804: 40400000  # OP1 (3.0)
  00000808: 3fc00000  # OP2 (1.5)
  0000080c: 00000000  # result slot
